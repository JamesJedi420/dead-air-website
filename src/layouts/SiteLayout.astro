---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
import "../styles/enhancements.css";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article";
  publishedTime?: Date | string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = "website",
  publishedTime,
  image,
  imageAlt,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0a" />
    <meta name="application-name" content="Dead Air" />
    <meta name="apple-mobile-web-app-title" content="Dead Air" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#b08d4a" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Dead Air RSS" href="/feed.xml" />
    <BaseHead
      title={title}
      description={description}
      ogType={ogType}
      publishedTime={publishedTime}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
