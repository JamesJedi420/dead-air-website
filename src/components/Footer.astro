---
import { primaryNav, utilityNav } from "../data/navigation";
const year = new Date().getFullYear();
const allNav = [...primaryNav, ...utilityNav];
const link = (label: string) => allNav.find((item) => item.label === label);
const groups = [
  { title: "Read", items: [link("Stories"), link("Cases"), link("Timeline"), link("Search")] },
  { title: "Archive", items: [link("Characters"), link("Locations"), link("Objects"), link("Mysteries")] },
  { title: "Project", items: [link("Research"), link("Content Notes"), link("About"), link("Contact"), link("Privacy"), link("RSS")] },
];
---

<footer class="site-footer">
  <div>
    <p class="footer-title">Dead Air</p>
    <p class="footer-note">The Dead Air Archive presents literary paranormal horror through stories and reader-facing records.</p>
  </div>
  <div class="footer-groups">
    {groups.map((group) => (
      <nav aria-label={`${group.title} links`}>
        <p class="footer-group-title">{group.title}</p>
        <div class="footer-group-links">
          {group.items.filter(Boolean).map((item) => item && <a href={item.href}>{item.label}</a>)}
        </div>
      </nav>
    ))}
  </div>
  <p class="copyright">&copy; {year} Dead Air. All rights reserved.</p>
</footer>
