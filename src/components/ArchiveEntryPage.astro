---
import Breadcrumbs from "./Breadcrumbs.astro";
import CanonBanner from "./CanonBanner.astro";
import RelatedEntries from "./RelatedEntries.astro";
import type { ArchiveCollection, ArchiveEntry, NormalizedEntry } from "../lib/archive";
import { canonWarning, collectionLabels, collectionPath, formatDate, formatLabel } from "../lib/archive";

interface Props {
  collection: ArchiveCollection;
  entry: ArchiveEntry;
  relatedEntries: NormalizedEntry[];
  previousEntry?: NormalizedEntry;
  nextEntry?: NormalizedEntry;
}

const { collection, entry, relatedEntries, previousEntry, nextEntry } = Astro.props;
const publicationDate = entry.data.publicationDate ?? entry.data.date;
const metadata = [
  ["Classification", entry.data.classification],
  ["Status", formatLabel(entry.data.status)],
  ["Canon", formatLabel(entry.data.canonicalStatus)],
  ["Published", formatDate(publicationDate)],
  ["Revision", entry.data.revision],
  ["Reading time", entry.data.readingTime],
].filter((item): item is [string, string] => Boolean(item[1]));
const contentNotes = [...entry.data.contentWarnings, ...entry.data.contentNotes];
---

<section class="section">
  <Breadcrumbs items={[
    { href: "/", label: "Home" },
    { href: collectionPath(collection), label: collectionLabels[collection] },
    { href: Astro.url.pathname, label: entry.data.title },
  ]} />
  <article class="entry-shell">
    <header class="entry-header">
      <p class="eyebrow">{collectionLabels[collection]}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <CanonBanner warnings={canonWarning(entry)} />
      {metadata.length > 0 && (
        <dl class="entry-meta">
          {metadata.map(([label, value]) => (
            <>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </>
          ))}
        </dl>
      )}
    </header>

    {contentNotes.length > 0 && (
      <aside class="callout pre-reading-note" aria-label="Content notes">
        <p class="eyebrow">Content Notes</p>
        <ul>
          {contentNotes.map((note) => <li>{note}</li>)}
        </ul>
      </aside>
    )}

    <div class="prose entry-content">
      <slot />
    </div>

    {(previousEntry || nextEntry) && (
      <nav class="story-pagination" aria-label="Story navigation">
        {previousEntry ? (
          <a class="story-pagination-link" href={previousEntry.url} rel="prev">
            <span class="eyebrow">Previous Story</span>
            <strong>{previousEntry.title}</strong>
          </a>
        ) : <span></span>}
        {nextEntry && (
          <a class="story-pagination-link story-pagination-link--next" href={nextEntry.url} rel="next">
            <span class="eyebrow">Next Story</span>
            <strong>{nextEntry.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>
</section>
<RelatedEntries entries={relatedEntries} />
