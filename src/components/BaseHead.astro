---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: "website" | "article";
  publishedTime?: Date | string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  ogType = "website",
  publishedTime,
  image,
  imageAlt,
  noindex = false,
} = Astro.props;

const siteTitle = "The Dead Air Archive";
const defaultSocialImage = "/images/dead-air-site__open-graph__archive-threshold__1200x630__brand__v1.1__20260913.png";
const defaultSocialImageAlt = "A brass DA monogram in a square frame beside two offset brass threshold frames on a dark field.";
const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const canonicalUrl = new URL(canonical, Astro.site ?? Astro.url).toString();
const resolvedImage = image ?? defaultSocialImage;
const resolvedImageAlt = image ? imageAlt : defaultSocialImageAlt;
const imageUrl = new URL(resolvedImage, Astro.site ?? Astro.url).toString();
const usesDefaultSocialImage = !image;
const publishedTimeValue = publishedTime
  ? publishedTime instanceof Date
    ? publishedTime.toISOString()
    : new Date(publishedTime).toISOString()
  : undefined;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow,noarchive" />}
<link rel="canonical" href={canonicalUrl} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
{resolvedImageAlt && <meta property="og:image:alt" content={resolvedImageAlt} />}
{usesDefaultSocialImage && <meta property="og:image:width" content="1200" />}
{usesDefaultSocialImage && <meta property="og:image:height" content="630" />}
{usesDefaultSocialImage && <meta property="og:image:type" content="image/png" />}
{ogType === "article" && publishedTimeValue && (
  <meta property="article:published_time" content={publishedTimeValue} />
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{resolvedImageAlt && <meta name="twitter:image:alt" content={resolvedImageAlt} />}
<link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href={new URL("/feed.xml", Astro.site ?? Astro.url)} />
