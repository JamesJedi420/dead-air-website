---
import { getCollection } from "astro:content";
import ArchiveBrowser from "../components/ArchiveBrowser.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { isPublished, normalizeEntry, sortEntries } from "../lib/archive";

const locations = sortEntries((await getCollection("locations")).filter(isPublished));
const entries = locations.map((entry) => normalizeEntry("locations", entry));
---

<SiteLayout title="Locations" description="Location records in The Dead Air Archive.">
  <section class="section">
    <div class="section-header">
      <p class="eyebrow">Locations</p>
      <h1>Locations</h1>
      <p>Location records bring together case, story, and phenomenon references.</p>
    </div>
    <ArchiveBrowser entries={entries} emptyMessage="No public location records have been opened yet." />
  </section>
</SiteLayout>
