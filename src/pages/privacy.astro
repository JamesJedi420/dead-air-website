---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Privacy" description="Privacy policy for The Dead Air Archive.">
  <section class="section">
    <div class="prose">
      <p class="eyebrow">Privacy</p>
      <h1>Privacy</h1>
      <p>
        This static site does not intentionally track visitors or collect analytics in this
        foundation build. Contact form submissions, if enabled by Netlify, are processed by
        Netlify's form service.
      </p>
      <p>
        Do not send confidential, identifying, or unpublished source material through public
        website channels.
      </p>
    </div>
  </section>
</SiteLayout>
