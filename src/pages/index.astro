---
import { getCollection } from "astro:content";
import ArchiveCard from "../components/ArchiveCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { entryUrl, isPublished } from "../lib/archive";

const publishedStories = (await getCollection("stories"))
  .filter(isPublished)
  .sort((a, b) =>
    Number(b.data.publicationDate ?? b.data.date ?? 0) -
    Number(a.data.publicationDate ?? a.data.date ?? 0)
  );
const publishedCases = (await getCollection("cases")).filter(isPublished);
const latestStory = publishedStories[0];
const startHereStory = [...publishedStories]
  .filter((story) => typeof story.data.timelineOrder === "number")
  .sort((a, b) => Number(a.data.timelineOrder) - Number(b.data.timelineOrder))[0] ?? publishedStories[publishedStories.length - 1];
const caseMeta = publishedCases.length > 0
  ? `${publishedCases.length} public case ${publishedCases.length === 1 ? "file is" : "files are"} currently open.`
  : "No public case files are currently open.";
---

<SiteLayout
  title="Dead Air"
  description="Literary paranormal horror told through stories, case records, object files, and disputed evidence."
>
  <section class="hero home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">Dead Air</p>
      <h1 id="home-title">Stories first. Records after.</h1>
      <p class="hero-deck">
        Literary paranormal horror built from reported investigations, contradictory testimony,
        documentary texture, and the things that refuse a clean explanation.
      </p>
      <div class="hero-actions" aria-label="Primary reading options">
        {startHereStory && (
          <a class="cta-link" href={entryUrl("stories", startHereStory)}>Start here</a>
        )}
        {latestStory && latestStory.id !== startHereStory?.id && (
          <a class="text-link" href={entryUrl("stories", latestStory)}>Read the latest story</a>
        )}
      </div>
    </div>

    <aside class="hero-panel home-feature" aria-label="Recommended starting story">
      <p class="eyebrow">Recommended Start</p>
      {startHereStory ? (
        <>
          <h2>{startHereStory.data.title}</h2>
          <p>{startHereStory.data.summary}</p>
          <div class="feature-meta">
            {startHereStory.data.readingTime && <span>{startHereStory.data.readingTime}</span>}
            {startHereStory.data.timelineLabel && <span>{startHereStory.data.timelineLabel}</span>}
          </div>
          <a class="text-link" href={entryUrl("stories", startHereStory)}>Read this story</a>
        </>
      ) : (
        <p>No public narrative file is currently available.</p>
      )}
    </aside>
  </section>

  {latestStory && latestStory.id !== startHereStory?.id && (
    <section class="section latest-release" aria-labelledby="latest-title">
      <div class="section-header">
        <p class="eyebrow">Latest Release</p>
        <h2 id="latest-title">{latestStory.data.title}</h2>
        <p>{latestStory.data.summary}</p>
      </div>
      <ArchiveCard
        href={entryUrl("stories", latestStory)}
        eyebrow="Latest Story"
        title={latestStory.data.title}
        summary={latestStory.data.summary}
        meta={[latestStory.data.readingTime, latestStory.data.publicationDate?.getFullYear()].filter(Boolean).join(" / ")}
        image={latestStory.data.coverImage}
        imageAlt={latestStory.data.coverAlt}
        cta="Read the latest story"
      />
    </section>
  )}

  <section class="section" aria-labelledby="index-title">
    <div class="section-header">
      <p class="eyebrow">Explore</p>
      <h2 id="index-title">The Dead Air Archive</h2>
      <p>
        Begin with the fiction. Then follow only the public records that the stories actually earn:
        cases, people, locations, objects, research, and unresolved questions.
      </p>
    </div>
    <div class="grid">
      <ArchiveCard
        href="/stories/"
        eyebrow="Stories"
        title="Read the fiction"
        summary="Long-form paranormal horror presented as finished literary work, not transcript summaries."
        meta={publishedStories.length > 0 ? `${publishedStories.length} public ${publishedStories.length === 1 ? "story" : "stories"}.` : "No public narrative files are currently open."}
        cta="Browse stories"
      />
      <ArchiveCard
        href="/cases/"
        eyebrow="Cases"
        title="Open the case files"
        summary="Public case summaries, evidence histories, and approved cross-references without hidden continuity or private source material."
        meta={caseMeta}
        cta="Browse cases"
      />
      <ArchiveCard
        href="/research-and-provenance/"
        eyebrow="Provenance"
        title="See how the archive handles sources"
        summary="How reported material, attribution, fictionalization, redaction, source custody, and publication boundaries are handled."
        meta="Editorial method and public-source discipline."
        cta="Read the standards"
      />
    </div>
  </section>

  <section class="section archive-threshold" aria-labelledby="archive-notice-title">
    <div class="section-header">
      <p class="eyebrow">Archive Boundary</p>
      <h2 id="archive-notice-title">Some records remain closed.</h2>
      <p>
        The public archive contains finished fiction and supporting reader-facing records. Raw
        transcripts, real identities, private source material, hidden continuity, and internal
        development notes remain outside it.
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .home-hero {
    align-items: end;
  }

  .home-hero h1 {
    max-width: 9ch;
  }

  .hero-deck {
    max-width: 36rem;
  }

  .hero-actions,
  .feature-meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .hero-actions {
    margin-top: 1.5rem;
  }

  .home-feature {
    background: linear-gradient(180deg, rgba(176, 141, 74, 0.07), rgba(255, 255, 255, 0.012));
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-red);
    max-width: 38rem;
    padding: 1.5rem;
  }

  .home-feature h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 0.75rem;
  }

  .feature-meta {
    color: var(--color-dim);
    font-size: 0.82rem;
    margin: 1rem 0;
  }

  .feature-meta span + span::before {
    color: var(--color-brass-dark);
    content: "/";
    margin-right: 0.75rem;
  }

  .cta-link {
    background: var(--color-brass);
    border-radius: 4px;
    color: var(--color-ink);
    display: inline-flex;
    font-weight: 700;
    padding: 0.7rem 1rem;
    text-decoration: none;
  }

  .cta-link:hover {
    color: var(--color-ink);
    filter: brightness(1.12);
  }

  .text-link {
    font-weight: 700;
  }

  .latest-release .archive-card {
    max-width: 48rem;
  }

  .archive-threshold {
    border-top: 1px solid var(--color-line);
  }
</style>
