---
import { getCollection } from "astro:content";
import ArchiveCard from "../components/ArchiveCard.astro";
import HomepageArchiveVisual from "../components/HomepageArchiveVisual.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { entryUrl, isPublished } from "../lib/archive";

const publishedStories = (await getCollection("stories"))
  .filter(isPublished)
  .sort((a, b) =>
    Number(b.data.publicationDate ?? b.data.date ?? 0) -
    Number(a.data.publicationDate ?? a.data.date ?? 0)
  );
const publishedCases = (await getCollection("cases")).filter(isPublished);
const latestStory = publishedStories[0];
const startHereStory = [...publishedStories]
  .filter((story) => typeof story.data.timelineOrder === "number")
  .sort((a, b) => Number(a.data.timelineOrder) - Number(b.data.timelineOrder))[0] ?? publishedStories[publishedStories.length - 1];
const caseMeta = publishedCases.length > 0
  ? `${publishedCases.length} public case ${publishedCases.length === 1 ? "file is" : "files are"} currently open.`
  : "No public case files are currently open.";
---

<SiteLayout
  title="Dead Air"
  description="Literary paranormal horror told through stories, case records, object files, and disputed evidence."
>
  <section class="hero home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">Dead Air</p>
      <h1 id="home-title">Stories first. Records after.</h1>
      <p class="hero-deck">
        Literary paranormal horror built from reported investigations, contradictory testimony,
        documentary texture, and the things that refuse a clean explanation.
      </p>
      <div class="hero-actions" aria-label="Primary reading options">
        {startHereStory && (
          <a class="cta-link" href={entryUrl("stories", startHereStory)}>Start here</a>
        )}
        {latestStory && latestStory.id !== startHereStory?.id && (
          <a class="text-link" href={entryUrl("stories", latestStory)}>Read the latest story</a>
        )}
      </div>
    </div>

    <div class="home-hero-visual">
      <HomepageArchiveVisual />
    </div>

    <aside class="hero-panel home-feature" aria-label="Recommended starting story">
      <p class="eyebrow">Recommended Start</p>
      {startHereStory ? (
        <>
          <h2>{startHereStory.data.title}</h2>
          <p>{startHereStory.data.summary}</p>
          <div class="feature-meta">
            {startHereStory.data.readingTime && <span>{startHereStory.data.readingTime}</span>}
            {startHereStory.data.timelineLabel && <span>{startHereStory.data.timelineLabel}</span>}
          </div>
          <a class="text-link" href={entryUrl("stories", startHereStory)}>Read this story</a>
        </>
      ) : (
        <p>No public narrative file is currently available.</p>
      )}
    </aside>
  </section>

  {latestStory && latestStory.id !== startHereStory?.id && (
    <section class="section latest-release" aria-labelledby="latest-title">
      <div class="section-header">
        <p class="eyebrow">Latest Release</p>
        <h2 id="latest-title">{latestStory.data.title}</h2>
        <p>{latestStory.data.summary}</p>
      </div>
      <ArchiveCard
        href={entryUrl("stories", latestStory)}
        eyebrow="Latest Story"
        title={latestStory.data.title}
        summary={latestStory.data.summary}
        meta={[latestStory.data.readingTime, latestStory.data.publicationDate?.getFullYear()].filter(Boolean).join(" / ")}
        image={latestStory.data.coverImage}
        imageAlt={latestStory.data.coverAlt}
        cta="Read the latest story"
      />
    </section>
  )}

  <section class="section" aria-labelledby="index-title">
    <div class="section-header">
      <p class="eyebrow">Explore</p>
      <h2 id="index-title">The Dead Air Archive</h2>
      <p>
        Begin with the fiction. Then follow the case files, people, locations, objects, research
        notes, and unresolved questions connected to what you’ve read.
      </p>
    </div>
    <div class="grid">
      <ArchiveCard
        href="/stories/"
        eyebrow="Stories"
        title="Read the fiction"
        summary="Long-form paranormal horror presented as finished literary work, not transcript summaries."
        meta={publishedStories.length > 0 ? `${publishedStories.length} public ${publishedStories.length === 1 ? "story" : "stories"}.` : "No public narrative files are currently open."}
        cta="Browse stories"
      />
      <ArchiveCard
        href="/cases/"
        eyebrow="Cases"
        title="Open the case files"
        summary="Case summaries, evidence histories, and cross-references assembled from the records available to the archive."
        meta={caseMeta}
        cta="Browse cases"
      />
      <ArchiveCard
        href="/research-and-provenance/"
        eyebrow="Provenance"
        title="Follow the record"
        summary="Notes on where archive material came from, what survives, what was reconstructed, and where the record remains uncertain."
        meta="Origin, custody, reconstruction, and gaps."
        cta="Read provenance notes"
      />
    </div>
  </section>

  <section class="section archive-threshold" aria-labelledby="archive-notice-title">
    <div class="section-header">
      <p class="eyebrow">Archive Status</p>
      <h2 id="archive-notice-title">Not every record survives intact.</h2>
      <p>
        Some entries are fragmentary, sealed, or withheld. A missing page may reflect damaged
        material, uncertain attribution, or a record the archive can acknowledge without
        reproducing.
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .home-hero {
    align-items: center;
    column-gap: clamp(2rem, 5vw, 5rem);
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    grid-template-rows: 1fr auto;
    overflow: visible;
    position: relative;
  }

  .hero-copy {
    align-self: center;
    grid-column: 1;
    grid-row: 1 / span 2;
    position: relative;
    z-index: 2;
  }

  .home-hero h1 {
    max-width: 9ch;
  }

  .hero-deck {
    max-width: 36rem;
  }

  .hero-actions,
  .feature-meta {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .hero-actions {
    margin-top: 1.5rem;
  }

  .home-hero-visual {
    align-self: end;
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    max-width: 46rem;
    position: relative;
    width: 100%;
    z-index: 1;
  }

  .home-hero-visual::after {
    border: 1px solid rgba(176, 141, 74, 0.18);
    content: "";
    inset: 0.85rem -0.85rem -0.85rem 0.85rem;
    pointer-events: none;
    position: absolute;
    z-index: -1;
  }

  .home-feature {
    background: rgba(18, 17, 15, 0.97);
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-red);
    box-shadow: 0 1.4rem 3.5rem rgba(0, 0, 0, 0.28);
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    margin-top: -2.4rem;
    max-width: 34rem;
    padding: 1.35rem 1.5rem 1.45rem;
    position: relative;
    width: calc(100% - clamp(2rem, 7vw, 4.5rem));
    z-index: 3;
  }

  .home-feature::before {
    background: var(--color-brass);
    content: "";
    height: 1px;
    left: 1.5rem;
    opacity: 0.45;
    position: absolute;
    top: 0.6rem;
    width: 3.5rem;
  }

  .home-feature h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 0.75rem;
  }

  .feature-meta {
    color: var(--color-dim);
    font-size: 0.82rem;
    margin: 1rem 0;
  }

  .feature-meta span + span::before {
    color: var(--color-brass-dark);
    content: "/";
    margin-right: 0.75rem;
  }

  .cta-link {
    background: var(--color-brass);
    border-radius: 4px;
    color: var(--color-ink);
    display: inline-flex;
    font-weight: 700;
    padding: 0.7rem 1rem;
    text-decoration: none;
  }

  .cta-link:hover {
    color: var(--color-ink);
    filter: brightness(1.12);
  }

  .text-link {
    font-weight: 700;
  }

  .latest-release .archive-card {
    max-width: 48rem;
  }

  .archive-threshold {
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 760px) {
    .home-hero {
      gap: 2.25rem;
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .hero-copy,
    .home-hero-visual,
    .home-feature {
      grid-column: 1;
      grid-row: auto;
    }

    .home-hero-visual {
      margin-top: 0.5rem;
      width: calc(100% - 0.75rem);
    }

    .home-feature {
      margin-top: -4rem;
      width: calc(100% - 1.5rem);
    }
  }

  @media (max-width: 480px) {
    .home-hero-visual::after {
      inset: 0.5rem -0.5rem -0.5rem 0.5rem;
    }

    .home-feature {
      margin-top: -2.5rem;
      width: calc(100% - 0.75rem);
    }
  }
</style>
