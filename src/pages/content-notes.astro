---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Content Notes" description="Content note policy for The Dead Air Archive.">
  <section class="section">
    <div class="prose">
      <p class="eyebrow">Reader Care</p>
      <h1>Content Notes</h1>
      <p>
        The archive is built for paranormal horror and may include grief, isolation, violence,
        distorted memory, institutional neglect, possession, occult implication, and dread.
      </p>
      <p>
        Individual story and case entries can carry more specific notes in their collection
        metadata when public content is imported.
      </p>
    </div>
  </section>
</SiteLayout>
