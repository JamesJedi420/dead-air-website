---
import { getCollection } from "astro:content";
import ArchiveBrowser from "../components/ArchiveBrowser.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { isPublished, normalizeEntry, sortEntries } from "../lib/archive";

const characters = sortEntries((await getCollection("characters")).filter(isPublished));
const entries = characters.map((entry) => normalizeEntry("characters", entry));
---

<SiteLayout title="Characters" description="Character records in The Dead Air Archive.">
  <section class="section">
    <div class="section-header">
      <p class="eyebrow">Characters</p>
      <h1>Characters</h1>
      <p>Character records connect appearances, cases, and locations across the archive.</p>
    </div>
    <ArchiveBrowser entries={entries} emptyMessage="No public character records have been opened yet." />
  </section>
</SiteLayout>
