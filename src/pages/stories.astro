---
import { getCollection } from "astro:content";
import ArchiveBrowser from "../components/ArchiveBrowser.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { isPublished, normalizeEntry, sortEntries } from "../lib/archive";

const stories = sortEntries((await getCollection("stories")).filter(isPublished));

// Legacy stories predate explicit cardImage metadata. Keep each exception explicit so
// future published stories cannot silently fall back to a differently proportioned
// cover/hero image and lose meaningful content or readable in-image text.
const fallbackCardMedia: Record<string, { image: string; alt: string }> = {
  "da-002-the-name-in-the-room": {
    image: "/images/da-002-story-card.svg",
    alt: "A closed institutional fire door in a dim basement corridor with a portable audio recorder in the foreground.",
  },
  "da-003-the-recorder-kept-running": {
    image: "/images/da-003-cover-option-a-evidence-crop-preview.jpg",
    alt: "Portable recorder resting on wet rocks beside dark water beneath the Dead Air mark; no person, grave marker, or apparition is visible.",
  },
};

const entries = stories.map((entry) => {
  const normalized = normalizeEntry("stories", entry);
  const fallback = fallbackCardMedia[normalized.slug];
  const cardImage = (entry.data as { cardImage?: string }).cardImage;

  if (cardImage && !normalized.coverAlt) {
    throw new Error(
      `Published story ${normalized.slug} has explicit cardImage metadata but no coverAlt. Add approved alt text before release.`,
    );
  }

  const media = cardImage
    ? { image: cardImage, alt: normalized.coverAlt }
    : fallback;

  if (!media) {
    throw new Error(
      `Published story ${normalized.slug} has no role-specific card image. Add explicit cardImage metadata using a crop-safe 3:2 derivative; do not rely on cover/hero cropping.`,
    );
  }

  return {
    ...normalized,
    coverImage: media.image,
    coverAlt: media.alt,
  };
});
---

<SiteLayout title="Stories" description="Published literary paranormal-horror stories from Dead Air.">
  <section class="section">
    <div class="section-header">
      <p class="eyebrow">Stories</p>
      <h1>Read Dead Air</h1>
      <p>
        Complete literary paranormal-horror stories from the public archive. Read the fiction first;
        case files and related records are available afterward for readers who want to follow the
        evidence, people, places, and unresolved questions further.
      </p>
    </div>
    <ArchiveBrowser
      entries={entries}
      emptyMessage="No public stories are currently available. Withheld records remain outside this index."
    />
  </section>
</SiteLayout>
