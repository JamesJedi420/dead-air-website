---
import { render } from "astro:content";
import ArchiveEntryPage from "../../components/ArchiveEntryPage.astro";
import StorySourceNote from "../../components/StorySourceNote.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getEntryStaticPaths } from "../../lib/loadArchive";

export const getStaticPaths = () => getEntryStaticPaths("stories");

const { collection, entry, relatedEntries } = Astro.props;
const { Content } = await render(entry);
const publicationDate = entry.data.publicationDate ?? entry.data.date;
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.summary}
  ogType="article"
  publishedTime={publicationDate}
>
  <ArchiveEntryPage collection={collection} entry={entry} relatedEntries={relatedEntries}>
    <StorySourceNote />
    <Content />
  </ArchiveEntryPage>
</SiteLayout>
