---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import ArchiveEntryPage from "../../components/ArchiveEntryPage.astro";
import ResponsiveStoryImage from "../../components/ResponsiveStoryImage.astro";
import StoryHero from "../../components/StoryHero.astro";
import StorySourceNote from "../../components/StorySourceNote.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getEntryStaticPaths } from "../../lib/loadArchive";

export const getStaticPaths = () => getEntryStaticPaths("stories");

const { collection, entry, relatedEntries, previousEntry, nextEntry } = Astro.props;
const storyEntry = entry as CollectionEntry<"stories">;
const { Content } = await render(storyEntry);
const publicationDate = storyEntry.data.publicationDate ?? storyEntry.data.date;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const socialImage = storyEntry.data.ogImage ?? storyEntry.data.coverImage;
const socialImageAlt = storyEntry.data.ogImage
  ? storyEntry.data.ogImageAlt
  : storyEntry.data.coverAlt;
const absolute = (value?: string) => value ? new URL(value, Astro.site ?? Astro.url).toString() : undefined;
const structuredImages = [storyEntry.data.coverImage, storyEntry.data.squareImage, storyEntry.data.socialImage]
  .map(absolute)
  .filter((value): value is string => Boolean(value));
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ShortStory",
  name: storyEntry.data.title,
  description: storyEntry.data.summary,
  url: canonical,
  ...(structuredImages.length ? { image: structuredImages } : {}),
  ...(storyEntry.data.cardImage ? { thumbnailUrl: absolute(storyEntry.data.cardImage) } : {}),
  isPartOf: {
    "@type": "CreativeWorkSeries",
    name: "Dead Air",
  },
};
const responsiveHero = Boolean(storyEntry.data.coverImage && storyEntry.data.keyArtImage);
---

<SiteLayout
  title={storyEntry.data.title}
  description={storyEntry.data.summary}
  ogType="article"
  publishedTime={publicationDate}
  image={socialImage}
  imageAlt={socialImageAlt}
  noindex={storyEntry.data.previewOnly}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  {responsiveHero && storyEntry.data.keyArtImage && (
    <link slot="head" rel="preload" as="image" href={storyEntry.data.keyArtImage} media="(max-width: 640px)" fetchpriority="high" />
  )}
  {responsiveHero && storyEntry.data.coverImage && (
    <link slot="head" rel="preload" as="image" href={storyEntry.data.coverImage} media="(min-width: 641px)" fetchpriority="high" />
  )}
  <ArchiveEntryPage
    collection={collection}
    entry={storyEntry}
    relatedEntries={relatedEntries}
    previousEntry={previousEntry}
    nextEntry={nextEntry}
  >
    {responsiveHero && storyEntry.data.coverImage ? (
      <StoryHero desktopSrc={storyEntry.data.coverImage} mobileSrc={storyEntry.data.keyArtImage} alt={storyEntry.data.coverAlt ?? ""} />
    ) : storyEntry.data.coverImage ? (
      <figure class="story-cover">
        <ResponsiveStoryImage
          src={storyEntry.data.coverImage}
          avif={storyEntry.data.coverImageAvif}
          webp={storyEntry.data.coverImageWebp}
          width={storyEntry.data.coverImageWidth}
          height={storyEntry.data.coverImageHeight}
          alt={storyEntry.data.coverAlt ?? ""}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    ) : null}
    <StorySourceNote />
    <Content />
  </ArchiveEntryPage>
</SiteLayout>

<style>
  .story-cover {
    margin: 0 auto 2rem;
    max-width: 36rem;
    overflow: hidden;
  }
</style>
