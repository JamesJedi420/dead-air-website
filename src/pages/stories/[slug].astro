---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import ArchiveEntryPage from "../../components/ArchiveEntryPage.astro";
import StorySourceNote from "../../components/StorySourceNote.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getEntryStaticPaths } from "../../lib/loadArchive";

export const getStaticPaths = () => getEntryStaticPaths("stories");

const { collection, entry, relatedEntries } = Astro.props;
const storyEntry = entry as CollectionEntry<"stories">;
const { Content } = await render(storyEntry);
const publicationDate = storyEntry.data.publicationDate ?? storyEntry.data.date;
---

<SiteLayout
  title={storyEntry.data.title}
  description={storyEntry.data.summary}
  ogType="article"
  publishedTime={publicationDate}
>
  <ArchiveEntryPage collection={collection} entry={storyEntry} relatedEntries={relatedEntries}>
    {storyEntry.data.coverImage && (
      <figure class="story-cover">
        <img src={storyEntry.data.coverImage} alt={storyEntry.data.coverAlt ?? ""} loading="eager" decoding="async" />
      </figure>
    )}
    <StorySourceNote />
    <Content />
  </ArchiveEntryPage>
</SiteLayout>

<style>
  .story-cover {
    margin: 0 auto 2rem;
    max-width: 36rem;
  }

  .story-cover img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.18));
  }
</style>
