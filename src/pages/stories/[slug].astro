---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import ArchiveEntryPage from "../../components/ArchiveEntryPage.astro";
import StoryHero from "../../components/StoryHero.astro";
import StorySourceNote from "../../components/StorySourceNote.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getEntryStaticPaths } from "../../lib/loadArchive";
export const getStaticPaths = () => getEntryStaticPaths("stories");
const { collection, entry, relatedEntries } = Astro.props;
const storyEntry = entry as CollectionEntry<"stories">;
const { Content } = await render(storyEntry);
const publicationDate = storyEntry.data.publicationDate ?? storyEntry.data.date;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const absolute = (value?: string) => value ? new URL(value, Astro.site ?? Astro.url).toString() : undefined;
const hero = storyEntry.data.coverImage;
const mobile = storyEntry.data.keyArtImage;
const og = storyEntry.data.ogImage ?? hero;
const structuredImages = [storyEntry.data.coverImage, storyEntry.data.squareImage, storyEntry.data.socialImage].map(absolute).filter(Boolean);
const structuredData = { "@context":"https://schema.org", "@type":"ShortStory", name:storyEntry.data.title, description:storyEntry.data.summary, url:canonical,
  ...(structuredImages.length ? { image: structuredImages } : {}), ...(storyEntry.data.cardImage ? { thumbnailUrl:absolute(storyEntry.data.cardImage) } : {}),
  isPartOf:{ "@type":"CreativeWorkSeries", name:"Dead Air" } };
---
<SiteLayout title={storyEntry.data.title} description={storyEntry.data.summary} ogType="article" publishedTime={publicationDate} image={og} noindex={storyEntry.data.previewOnly}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  {mobile && <link slot="head" rel="preload" as="image" href={mobile} media="(max-width: 640px)" fetchpriority="high" />}
  {hero && <link slot="head" rel="preload" as="image" href={hero} media="(min-width: 641px)" fetchpriority="high" />}
  <ArchiveEntryPage collection={collection} entry={storyEntry} relatedEntries={relatedEntries}>
    {hero && <StoryHero desktopSrc={hero} mobileSrc={mobile} alt={storyEntry.data.coverAlt ?? ""} />}
    <StorySourceNote /><Content />
  </ArchiveEntryPage>
</SiteLayout>
