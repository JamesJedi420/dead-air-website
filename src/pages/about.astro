---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="About" description="About the editorial purpose of The Dead Air Archive.">
  <section class="section">
    <div class="prose">
      <p class="eyebrow">About</p>
      <h1>About</h1>
      <p>
        The Dead Air Archive is a public-facing catalogue for a literary paranormal horror
        project: stories, case summaries, character records, locations, objects, and mysteries
        prepared for readers rather than internal production.
      </p>
      <p>
        Its design borrows from institutional files, basement reading rooms, and oxidized metal
        labels without turning the archive into spectacle. The site should feel quiet, legible,
        and faintly contaminated by the records it preserves.
      </p>
    </div>
  </section>
</SiteLayout>
