---
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Email Signup Received"
  description="Your Dead Air release-email signup request was received."
  noindex={true}
>
  <section class="section">
    <div class="prose">
      <p class="eyebrow">Email Updates</p>
      <h1>Signup received.</h1>
      <p>
        Your request to receive Dead Air release emails was received. If a confirmation email
        arrives, use it to complete the subscription.
      </p>
      <p><a href="/stories/">Browse the stories</a> or <a href="/">return home</a>.</p>
    </div>
  </section>
</SiteLayout>
