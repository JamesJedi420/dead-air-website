---
import SiteLayout from "../layouts/SiteLayout.astro";
import { normalizeEntry } from "../lib/archive";
import { getPublishedCollection } from "../lib/loadArchive";

const timelineEntries = [
  ...(await getPublishedCollection("stories")).map((entry) => normalizeEntry("stories", entry)),
  ...(await getPublishedCollection("cases")).map((entry) => normalizeEntry("cases", entry)),
]
  .filter((entry) => entry.timelineOrder !== undefined)
  .sort((a, b) => {
    const orderDifference = a.timelineOrder! - b.timelineOrder!;
    if (orderDifference !== 0) return orderDifference;
    if (a.collection !== b.collection) return a.collection === "stories" ? -1 : 1;
    return a.title.localeCompare(b.title);
  });

const precisionLabels = {
  exact: "High date confidence",
  approximate: "Approximate date",
  seasonal: "Seasonal placement",
  relative: "Relative placement",
} as const;

const intervalLabels = new Map([
  ["da-002-the-name-in-the-room", "About one month after the DA-001 investigation; about three weeks after its sealed-corridor coda."],
]);
---

<SiteLayout
  title="Narrative Timeline"
  description="The approximate in-world chronology of events recorded across The Dead Air Archive."
>
  <section class="section">
    <div class="section-header">
      <p class="eyebrow">Narrative Chronology</p>
      <h1>Timeline</h1>
      <p>
        This timeline shows when each case approximately occurs in the stories. Dates are intentionally
        ranged or seasonal when the record cannot support greater precision. Confidence describes the date placement,
        not the truth of a paranormal interpretation. Recording dates, source publication dates, and Dead Air release
        dates remain separate provenance.
      </p>
    </div>
    {timelineEntries.length > 0 ? (
      <ol class="timeline-list">
        {timelineEntries.map((entry) => {
          const interval = intervalLabels.get(entry.slug);
          return (
            <li class="timeline-entry">
              {interval && <p class="timeline-interval">{interval}</p>}
              <p class="timeline-date">{entry.timelineLabel ?? "Date unresolved"}</p>
              {entry.datePrecision && <p class="timeline-confidence">{precisionLabels[entry.datePrecision]}</p>}
              <h2><a href={entry.url}>{entry.title}</a></h2>
              <p>{entry.summary}</p>
              {entry.chronologyNote && <p class="chronology-note">{entry.chronologyNote}</p>}
            </li>
          );
        })}
      </ol>
    ) : (
      <div class="callout">
        <p>No dated story or case records are available yet.</p>
      </div>
    )}
  </section>
</SiteLayout>

<style>
  .timeline-list {
    border-left: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-entry {
    border-left: 1px solid var(--color-line);
    margin-left: 0.45rem;
    padding: 0 0 2.75rem 1.5rem;
    position: relative;
  }

  .timeline-entry::before {
    background: var(--color-brass);
    border-radius: 50%;
    content: "";
    height: 0.65rem;
    left: -0.36rem;
    position: absolute;
    top: 0.35rem;
    width: 0.65rem;
  }

  .timeline-date {
    color: var(--color-brass);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .timeline-confidence {
    color: var(--color-muted);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .timeline-interval {
    color: var(--color-muted);
    font-size: 0.9rem;
    font-style: italic;
    margin: 0 0 1.1rem;
  }

  .chronology-note {
    border-left: 2px solid var(--color-line);
    color: var(--color-muted);
    margin: 1rem 0 0;
    padding-left: 0.75rem;
  }
</style>
